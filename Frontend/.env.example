# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Symfony REST Backend API URL (when connecting React to Symfony)
VITE_SYMFONY_API_URL="http://localhost:8000/api"

# PostgreSQL Database Configuration
# Option A: Connection string (recommended for Neon, Supabase, Cloud SQL, Railway, Render)
DATABASE_URL=postgresql://postgres:secret@localhost:5432/minijira

# Option B: Individual PostgreSQL parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=minijira
PGUSER=postgres
PGPASSWORD=secret
PGSSLMODE=disable

# Authentication & Security
JWT_SECRET=remplacer_par_une_cle_secrete_aleatoire_de_64_caracteres_hex

# Email Configuration (for transactional notifications and invites)
# Recommended providers: Resend, SendGrid, Postmark, or custom SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mini-Jira <notifications@minijira.io>"
RESEND_API_KEY=

